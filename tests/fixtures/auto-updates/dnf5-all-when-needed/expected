# Written by workbench-distro (wb tools install auto-updates).
# workbench-auto-updates: scope=all reboot=when-needed enabled-timers=dnf5-automatic.timer
# Change with: AUTO_UPDATES_SCOPE=<security|all> AUTO_UPDATES_REBOOT=<never|when-needed> wb tools upgrade auto-updates
# Turn off with: distro-auto-updates off
[commands]
upgrade_type = default
download_updates = True
apply_updates = True
reboot = when-needed

[emitters]
emit_via = stdio
